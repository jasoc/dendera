# Dendera local (development) environment. Copy to `.env` (gitignored) and adjust if needed —
# ./scripts/run.sh creates this file for you from these defaults if it's missing.
#
# Every variable is exported to the dev scripts as-is: the names are the literal ASP.NET Core
# config keys (ConnectionStrings__Dendera -> ConnectionStrings:Dendera, and so on). The
# container (docker-compose.yml) does not read this file.

ASPNETCORE_ENVIRONMENT=Development

# SQLite file, relative to src/backend/Dendera.Api (where dev-server.sh runs the API).
# ConnectionStrings__Dendera=Data Source=dendera.db

# Rule-set directory, relative to the API's output folder.
# Dendera__RulesDirectory=rules

# Interface the dev servers listen on: localhost (default) or 0.0.0.0 to reach them from other devices.
# DENDERA_HOST=0.0.0.0
