  // Weights: the Neijing gives an order, not numbers. Suwen 22 (藏氣法時論) follows each organ through the
  // seasons, the days and the hours; Suwen 2 (四氣調神大論) the four seasons; Suwen 5 (陰陽應象大論) the six qi.
  // Order kept: season (0.6) frames the year, climate excesses (0.3–0.7), the hour (0.25). The numbers are a
  // convention of the instrument (calibration plan, step 1 F). Unschuld & Tessenow, Huang Di Nei Jing Su Wen (2011).
  "rules": [
    {
      // Najia (stems to organs): the day's heavenly stem opens its organ's meridian — Jia gallbladder, Yi liver,
      // Bing small intestine, Ding heart, Wu stomach, Ji spleen, Geng large intestine, Xin lung, Ren bladder,
      // Gui kidney (Ziwu liuzhu; Xu Feng, Zhenjiu daquan, 1439 — to check). Weight: convention, below the season.
      "id": "day-stem",
      "name": "Tronco celeste del giorno → il meridiano del suo organo",
      "about": "Nel calendario sessagesimale ogni giorno ha un tronco celeste; il metodo Najia associa ogni tronco a un organo, il cui meridiano quel giorno è «aperto».",
      "source": "Letteratura Ziwu liuzhu (He Ruoyu, 1153; Xu Feng, Zhenjiu daquan, 1439) — edizione da verificare",
      "when": { "kind": "ganzhi" },
      "effect": { "zonesFrom": ["dayStem"], "weight": 0.2, "quality": "flow" },
      "text": "Giorno {dayStem} ({dayBranch}): il tronco del giorno apre il meridiano del suo organo"
    },
    {
      "id": "season-wood",
      "name": "Stagione del Legno (primavera) → Fegato e Vescica biliare",
      "about": "Dal termine solare corrente: la stagione del Legno mette in primo piano gli organi del suo elemento.",
      "source": "Huangdi Neijing Suwen, cap. 2 e 4",
      "when": {
        "kind": "solar-term",
        "tags": {
          "element": [
            "wood"
          ]
        }
      },
      "effect": {
        "zones": [
          "zf-liver",
          "zf-gallbladder"
        ],
        "weight": 0.6,
        "quality": "sensitivity"
      },
      "text": "Stagione del Legno ({term}): Fegato e Vescica biliare in primo piano"
    },
