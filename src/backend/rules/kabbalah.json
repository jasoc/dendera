{
  // School: Hermetic Kabbalah (Adam Kadmon). The ten Sephiroth of the Tree of Life on the body, moved by the
  // condition of their planets. Borrows the planets from astrology (declared). Zones: Dendera.Core/Rules/BodyZones.cs.
  "id": "kabbalah",
  "version": "1.0.0",
  "name": "Cabala ermetica",
  "icon": "school-kabbalah",
  "lineage": "hermetic",
  "parents": ["western-astrology"],
  "tradition": "Cabala ermetica: l'Albero della Vita sul corpo dell'Adam Kadmon",
  "description": "L'uomo primordiale, Adam Kadmon, porta in sé le dieci Sephiroth dell'Albero della Vita, dalla Corona sopra il capo al Regno sotto i piedi. Sette di esse sono le sfere dei pianeti: quando un pianeta governa l'ora, si ferma, retrocede, è forte o debole nel suo segno, o si lega a un altro con un aspetto, la sua Sephirah si accende o si contrae, e con essa la parte del corpo dove abita.",
  "references": [
    "Enrico Cornelio Agrippa, De occulta philosophia (1533), libro III, cap. 10: le emanazioni divine, le dieci Sephiroth e i nomi che le governano",
    "Agrippa, De occulta philosophia, libro III, cap. 13: le membra di Dio e il loro influsso sulle nostre membra",
    "Sefer Yetzirah: le dieci Sephiroth e i ventidue sentieri",
    "Le attribuzioni planetarie dell'Ordine della Golden Dawn (fine XIX sec.), sintesi moderna"
  ],
  "requires": ["ephemeris", "planetary-hours"],
  "baseline": "none",
  "natalAmplification": 0,
  "saturation": 2.5,

  "correspondences": {
    // Planets → Sephiroth (Agrippa III.10): Saturn Binah, Jupiter Chesed, Mars Geburah, Sun Tiphereth,
    // Venus Netzach, Mercury Hod, Moon Yesod.
    "saturn": ["binah"], "jupiter": ["chesed"], "mars": ["geburah"], "sun": ["tiphereth"],
    "venus": ["netzach"], "mercury": ["hod"], "moon": ["yesod"]
  },

  "rules": [
    { "id": "hour-sephirah", "name": "Pianeta dell'ora e del giorno → la sua Sephirah",
      "about": "Il pianeta che governa l'ora accende la sfera dell'Albero che gli corrisponde.",
      "source": "Agrippa, De occulta philosophia, III.10; Picatrix (ore planetarie)", "when": { "kind": "planetary-hour" },
      "effect": { "zonesFrom": ["ruler", "dayRuler"], "weight": 0.25, "quality": "flow" },
      "text": "Ora di {ruler} nel giorno di {dayRuler}: le loro Sephiroth si accendono" },
    { "id": "retrograde-sephirah", "name": "Pianeta retrogrado → la sua Sephirah si ritira",
      "about": "La sfera del pianeta segue il suo moto.",
      "source": "Agrippa, De occulta philosophia, III.10", "when": { "kind": "retrograde" },
      "effect": { "zonesFrom": ["body"], "weight": 0.5, "quality": "inward" },
      "text": "{body} retrogrado: la sua Sephirah si ritira" },
    { "id": "station-sephirah", "name": "Pianeta stazionario → la sua Sephirah si concentra",
      "about": "Nel punto di svolta la sfera si concentra.",
      "source": "Agrippa, De occulta philosophia, III.10", "when": { "kind": "station", "minIntensity": 0.2 },
      "effect": { "zonesFrom": ["body"], "weight": 0.6, "quality": "pressure" },
      "text": "{body} stazionario: la sua Sephirah si concentra" },
    { "id": "dignified-sephirah", "name": "Pianeta dignitoso → la sua Sephirah è forte",
      "about": "Un pianeta forte nel segno rafforza la sua emanazione.",
      "source": "Agrippa, De occulta philosophia, III.10; Lilly (dignità)", "when": { "kind": "dignity", "tags": { "condition": ["dignified"] } },
      "effect": { "zonesFrom": ["body"], "weight": 0.4, "quality": "flow" },
      "text": "{body} {dignity}: la sua Sephirah è forte" },
    { "id": "debilitated-sephirah", "name": "Pianeta debilitato → la sua Sephirah in difficoltà",
      "about": "Un pianeta debole nel segno indebolisce la sua emanazione.",
      "source": "Agrippa, De occulta philosophia, III.10; Lilly (dignità)", "when": { "kind": "dignity", "tags": { "condition": ["debilitated"] } },
      "effect": { "zonesFrom": ["body"], "weight": 0.4, "quality": "tension" },
      "text": "{body} {dignity}: la sua Sephirah è in difficoltà" },
    { "id": "aspect-path", "name": "Aspetto tra due pianeti → un sentiero tra le loro Sephiroth",
      "about": "Due pianeti in aspetto collegano le loro sfere sull'Albero.",
      "source": "Sefer Yetzirah (i sentieri); attribuzioni della Golden Dawn", "when": { "kind": "sky-aspect" },
      "effect": { "zonesFrom": ["bodyA", "bodyB"], "weight": 0.3 },
      "text": "{bodyA} in {aspect} con {bodyB}: un sentiero tra le loro Sephiroth" },
    // Chokmah is the sphere of the zodiac and of the fixed stars (Agrippa III.10).
    { "id": "stars-chokmah", "name": "Pianeta su una stella fissa → Chokmah",
      "about": "Chokmah è la sfera dello zodiaco e delle stelle fisse.",
      "source": "Agrippa, De occulta philosophia, III.10", "when": { "kind": "fixed-star" },
      "effect": { "zones": ["chokmah"], "weight": 0.4, "quality": "flow" },
      "text": "{body} su {star}: la sfera delle stelle fisse" },
    { "id": "eclipse-luminaries", "name": "Eclissi → Tiphereth e Yesod",
      "about": "Sole e Luna, sfere di Tiphereth e Yesod, si oscurano a vicenda.",
      "source": "Agrippa, De occulta philosophia, III.10", "when": { "kind": "eclipse" },
      "effect": { "zones": ["tiphereth", "yesod"], "weight": 0.6, "quality": "tension" },
      "text": "Eclissi: il Sole e la Luna, Tiphereth e Yesod, si oscurano a vicenda" },
    { "id": "moon-yesod", "name": "Fase lunare → Yesod",
      "about": "Yesod è la sfera della Luna.",
      "source": "Agrippa, De occulta philosophia, III.10", "when": { "kind": "lunar-phase" },
      "effect": { "zones": ["yesod"], "weight": 0.3, "quality": "flow" },
      "text": "{phase}: Yesod, la sfera della Luna" },

    // The Sephiroth on the body of Adam Kadmon (Agrippa III.10; the usual placement of the Tree on the body).
    { "id": "kether-body", "name": "Kether, Chokmah, Binah → il capo",
      "about": "Le tre Sephiroth superne stanno sul capo dell'Adam Kadmon.",
      "source": "Agrippa, De occulta philosophia, III.13 (le membra divine)", "when": { "kind": "node", "tags": { "node": ["kether", "chokmah", "binah"] }, "minIntensity": 0.2 },
      "effect": { "zones": ["head", "brain"], "weight": 0.3 }, "text": "{node} ({detail}): il capo" },
    { "id": "arms-body", "name": "Chesed, Geburah → le braccia",
      "about": "Misericordia e Forza sono le braccia destra e sinistra.",
      "source": "Agrippa, III.13", "when": { "kind": "node", "tags": { "node": ["chesed", "geburah"] }, "minIntensity": 0.2 },
      "effect": { "zones": ["shoulders"], "weight": 0.3 }, "text": "{node} ({detail}): le braccia" },
    { "id": "tiphereth-body", "name": "Tiphereth → il cuore",
      "about": "La Bellezza è il centro, il cuore.",
      "source": "Agrippa, III.13", "when": { "kind": "node", "tags": { "node": ["tiphereth"] }, "minIntensity": 0.2 },
      "effect": { "zones": ["heart"], "weight": 0.3 }, "text": "Tiphereth ({detail}): il cuore" },
    { "id": "hips-body", "name": "Netzach, Hod → le anche",
      "about": "Vittoria e Gloria sono le anche e le gambe.",
      "source": "Agrippa, III.13", "when": { "kind": "node", "tags": { "node": ["netzach", "hod"] }, "minIntensity": 0.2 },
      "effect": { "zones": ["thighs"], "weight": 0.3 }, "text": "{node} ({detail}): le anche" },
    { "id": "yesod-body", "name": "Yesod → i genitali",
      "about": "Il Fondamento è l'organo della generazione.",
      "source": "Agrippa, III.13", "when": { "kind": "node", "tags": { "node": ["yesod"] }, "minIntensity": 0.2 },
      "effect": { "zones": ["pelvis"], "weight": 0.3 }, "text": "Yesod ({detail}): i genitali" }
  ]
}
