{
  // School: Biometeorologia. Rules are hypotheses: the journal + correlation engine tests them.
  // Zones must be ids from Dendera.Core/Rules/BodyZones.cs (validated at load).
  "id": "biometeorology",
  "version": "1.3.0",
  "name": "Biometeorologia",
  "icon": "school-biometeorology",
  "lineage": "modern-science",
  "parents": ["galenic"],
  "tradition": "Biometeorologia umana: effetti di tempo atmosferico, luce e geomagnetismo sul corpo",
  "description": "Il corpo risponde all'ambiente fisico: poca luce rallenta il ritmo circadiano, i cali di pressione si sentono in testa e nelle articolazioni, le tempeste geomagnetiche agitano sonno e sistema nervoso. Nessun simbolismo: solo grandezze fisiche misurate nel luogo in cui vivi.",
  "references": [
    "Ippocrate, Arie, acque, luoghi (V sec. a.C.)",
    "International Society of Biometeorology (dal 1956), International Journal of Biometeorology",
    "Ricerca sulla meteoropatia e sul disturbo affettivo stagionale (SAD)",
    "Studi eliobiologici di A. L. Čiževskij (anni '20–'30) sull'attività solare e geomagnetica",
    "Risonanze di Schumann: W. O. Schumann (1952); ipotesi di R. Wever sui ritmi circadiani (anni '60–'70)"
  ],
  "requires": ["ephemeris", "gfz", "open-meteo", "schumann", "noaa-swpc", "air-quality"],
  "baseline": "none",

  "natalAmplification": 0,
  "saturation": 2.5,

  "rules": [
    {
      // Solar wind and southward Bz drive geomagnetic storms (Gonzalez et al., J. Geophys. Res. 99, 1994); the body
      // zones are those of the Kp rule. Weights: convention, below the Kp itself.
      "id": "solar-wind",
      "name": "Vento solare veloce → nervi, sonno, cuore",
      "about": "Un vento solare sopra i 400 km/s carica la magnetosfera e prepara le tempeste geomagnetiche che il corpo sente.",
      "source": "NOAA SWPC; Gonzalez et al., J. Geophys. Res. 99 (1994)",
      "when": { "kind": "solar-wind", "minIntensity": 0.25 },
      "effect": { "zones": ["nervous-system", "sleep", "heart"], "weight": 0.5, "quality": "agitation" },
      "text": "Vento solare veloce ({detail})"
    },
    {
      "id": "imf-south",
      "name": "Campo interplanetario verso sud → nervi, sonno, cuore",
      "about": "Quando la componente Bz punta a sud la magnetosfera si apre all'energia del Sole: è la condizione delle tempeste.",
      "source": "Gonzalez et al., «What is a geomagnetic storm?», J. Geophys. Res. 99 (1994)",
      "when": { "kind": "imf-bz", "minIntensity": 0.5 },
      "effect": { "zones": ["nervous-system", "sleep", "heart"], "weight": 0.5, "quality": "agitation" },
      "text": "Campo interplanetario verso sud ({detail}): la magnetosfera si apre"
    },
    {
      // M-class flares and above (NOAA R1+). Weight: convention.
      "id": "flare",
      "name": "Brillamento solare M o X → nervi, testa",
      "about": "I brillamenti forti disturbano la ionosfera (radio blackout); l'eliobiologia ne cerca gli effetti sul sistema nervoso.",
      "source": "NOAA, scala R; A. L. Čiževskij, studi eliobiologici",
      "when": { "kind": "xray-flare", "minIntensity": 0.5 },
      "effect": { "zones": ["nervous-system", "head"], "weight": 0.4, "quality": "agitation" },
      "text": "Brillamento solare ({detail})"
    },
    {
      // Air pollution above the WHO 2021 guidelines: airways, heart and circulation (WHO global air quality
      // guidelines, 2021). Weight: convention.
      "id": "air-pollution",
      "name": "Aria oltre le linee guida OMS → polmoni, cuore, circolazione",
      "about": "Polveri sottili, ozono e biossido di azoto sopra le soglie dell'OMS pesano su vie respiratorie, cuore e vasi.",
      "source": "OMS, Global air quality guidelines (2021)",
      "when": { "kind": "air-quality", "minIntensity": 0.5 },
      "effect": { "zones": ["lungs", "heart", "circulation"], "weight": 0.6, "quality": "pressure" },
      "text": "Aria: {pollutant} {level} ({detail})"
    },
    {
      // Pollen at "high" counts (UK Met Office bands): nose, eyes and airways. Weight: convention.
      "id": "pollen",
      "name": "Pollini alti → naso, occhi, polmoni",
      "about": "Nei giorni di pollini alti naso, occhi e bronchi reagiscono.",
      "source": "UK Met Office, fasce di conteggio dei pollini",
      "when": { "kind": "pollen", "minIntensity": 0.5 },
      "effect": { "zones": ["nose", "eyes", "lungs"], "weight": 0.6, "quality": "agitation" },
      "text": "Pollini di {type} alti ({detail})"
    },
    {
      // UV index 6+ (high, WHO 2002): skin and eyes. Weight: convention.
      "id": "uv",
      "name": "Indice UV alto → pelle e occhi",
      "about": "Dall'indice 6 i raggi UV sono alti per la pelle e gli occhi.",
      "source": "OMS, Global Solar UV Index (2002)",
      "when": { "kind": "uv", "minIntensity": 0.55 },
      "effect": { "zones": ["skin", "eyes"], "weight": 0.4, "quality": "pressure" },
      "text": "Raggi UV forti ({detail})"
    },
    {
      // SAD: Rosenthal et al., Arch. Gen. Psychiatry 41:72–80 (1984); more winter SAD further north ("Prevalence of
      // seasonal affective disorder at four latitudes", 1990). No threshold in hours of light: convention.
      "id": "light-deficit",
      "name": "Poca luce del giorno → sonno, umore, vitalità",
      "about": "Le giornate corte rallentano l'orologio interno e abbassano umore ed energia: il disturbo affettivo stagionale.",
      "source": "Rosenthal et al., Archives of General Psychiatry 41 (1984)",
      "when": { "kind": "photoperiod", "minIntensity": 0.05 },
      "effect": { "zones": ["sleep", "mood", "vitality", "melancholic"], "weight": 0.9, "quality": "depletion" },
      "text": "Poca luce ({detail}): il Sole scende e il ritmo circadiano rallenta"
    },
    {
      "id": "light-change",
      "name": "La luce cambia in fretta → sonno",
      "about": "Intorno agli equinozi le giornate cambiano di minuti ogni giorno e l'orologio interno deve riadattarsi.",
      "source": "Convenzione dello strumento",
      "when": { "kind": "photoperiod-change", "minIntensity": 0.3 },
      "effect": { "zones": ["sleep"], "weight": 0.4, "quality": "pressure" },
      "text": "La luce cambia in fretta ({detail})"
    },
    {
      // Storms from Kp 5 (G1), NOAA SWPC Space Weather Scales; heart attacks and strokes reported on storm days
      // (scoping review of 36 studies, Cureus 2025; Int. J. Biometeorol. 58:799, 2014). Intensity 0.2 = Kp 5.
      "id": "geomagnetic",
      "name": "Tempesta geomagnetica → nervi, sonno, cuore, testa, paura",
      "about": "Dal Kp 5 (tempesta G1) il campo magnetico terrestre si agita; sono riportati più infarti e ictus nei giorni di tempesta.",
      "source": "NOAA, scala G; scoping review su 36 studi (Cureus 2025)",
      "when": { "kind": "geomagnetic", "minIntensity": 0.2 },
      "effect": { "zones": ["nervous-system", "sleep", "heart", "head", "fear"], "weight": 1.0, "quality": "agitation" },
      "text": "Attività geomagnetica ({detail}): il campo terrestre vibra"
    },
    {
      // Kimoto et al., Intern. Med. 50 (2011): drop > 5 hPa on the day before. Intensity 0.5 = 5 hPa.
      "id": "pressure-drop",
      "name": "Pressione che cala di 5 hPa → testa, ginocchia, ossa",
      "about": "Un calo di pressione di oltre 5 hPa rispetto al giorno prima precede emicranie e dolori articolari.",
      "source": "Kimoto et al., Internal Medicine 50 (2011)",
      "when": { "kind": "pressure-change", "tags": { "direction": ["drop"] }, "minIntensity": 0.5 },
      "effect": { "zones": ["head", "knees", "skeleton"], "weight": 0.8, "quality": "pressure" },
      "text": "Pressione in calo ({detail})"
    },
    {
      // Rises: the literature reports drops; same 5 hPa threshold by symmetry, convention.
      "id": "pressure-rise",
      "name": "Pressione che sale di 5 hPa → testa",
      "about": "La salita brusca di pressione è meno studiata del calo; la soglia è la stessa per simmetria.",
      "source": "Convenzione dello strumento",
      "when": { "kind": "pressure-change", "tags": { "direction": ["rise"] }, "minIntensity": 0.5 },
      "effect": { "zones": ["head"], "weight": 0.3, "quality": "pressure" },
      "text": "Pressione in salita ({detail})"
    },
    {
      // Okuma et al., SpringerPlus 4 (2015): 6–10 hPa below 1013 at sea level. Intensity 0.6 = 1007 hPa.
      "id": "low-pressure",
      "name": "Pressione bassa → testa, vitalità",
      "about": "Sotto i 1007 hPa (6 sotto lo standard) le emicranie sono più frequenti.",
      "source": "Okuma et al., SpringerPlus 4 (2015)",
      "when": { "kind": "pressure", "minIntensity": 0.6 },
      "effect": { "zones": ["head", "vitality"], "weight": 0.4, "quality": "depletion" },
      "text": "Bassa pressione ({detail})"
    },
    {
      // Guo et al., PLoS ONE 6 (2011): > 3 °C between neighbouring days' mean temperature. Intensity 0.3 = 3 °C.
      "id": "temperature-swing",
      "name": "Sbalzo di 3 °C tra un giorno e l'altro → circolazione, vitalità",
      "about": "Un cambio di oltre 3 °C nella temperatura media tra giorni vicini aumenta il carico sul cuore.",
      "source": "Guo et al., PLoS ONE 6 (2011)",
      "when": { "kind": "temperature-swing", "minIntensity": 0.3 },
      "effect": { "zones": ["circulation", "vitality"], "weight": 0.4, "quality": "tension" },
      "text": "Sbalzo termico ({detail})"
    },
    {
      // Humidity: no threshold from the sources read in step 1; convention.
      "id": "humidity",
      "name": "Umidità alta → ossa, linfa",
      "about": "L'aria umida si sente nelle articolazioni e nei liquidi; soglia senza fonte precisa.",
      "source": "Ippocrate, Arie, acque, luoghi; soglia: convenzione",
      "when": { "kind": "humidity", "minIntensity": 0.3 },
      "effect": { "zones": ["skeleton", "lymph"], "weight": 0.3, "quality": "pressure" },
      "text": "Umidità alta ({detail})"
    },
    {
      // Derived index (schumannresonancelive.com, CC0, relative 0–100 from the Tomsk TSU spectrograms): no
      // published threshold. ≥ 60 kept as a conservative convention until samples are persisted and calibrated.
      "id": "schumann",
      "name": "Risonanza di Schumann alta → nervi, sonno, umore",
      "about": "Indice derivato degli spettrogrammi di Tomsk; l'ipotesi di Wever lega queste onde ai ritmi circadiani. Da prendere con cautela.",
      "source": "W. O. Schumann (1952); R. Wever, esperimenti sui ritmi circadiani (anni '60–'70)",
      "when": { "kind": "schumann", "minIntensity": 0.6 },
      "effect": { "zones": ["nervous-system", "sleep", "mood"], "weight": 0.5, "quality": "agitation" },
      "text": "Risonanza di Schumann alta ({detail}): dato derivato, da prendere con cautela"
    }
  ]
}
