  "rules": [
    {
      // The Moon's nakshatra and its Vimshottari lord (Parashara): the lord's chakra after Frawley (modern synthesis,
      // like the planet → chakra map of this school). Weight: convention.
      "id": "nakshatra-chakra",
      "name": "Nakshatra della Luna → il chakra del suo signore",
      "about": "Il pianeta che governa la stazione lunare del giorno accende il proprio chakra.",
      "source": "Parashara (signori dei nakshatra); David Frawley, pianeti e chakra (sintesi moderna)",
      "when": { "kind": "nakshatra" },
      "effect": { "zonesFrom": ["lord"], "weight": 0.25, "quality": "flow" },
      "text": "Luna in {nakshatra} (pada {pada}), signore {lord}: il suo chakra"
    },
    {
      // The running Vimshottari period (Parashara, BPHS): the mahadasha lord's chakra for years, the antardasha's
      // for months. Weights: convention.
      "id": "dasha-chakra",
      "name": "Periodo dasha → i chakra dei suoi signori",
      "about": "Il pianeta del periodo maggiore e quello del sotto-periodo restano in primo piano per anni e mesi.",
      "source": "Parashara, BPHS (dasha); Frawley (chakra)",
      "when": { "kind": "dasha" },
      "effect": { "zonesFrom": ["lord", "subLord"], "weight": 0.3, "quality": "sensitivity" },
      "text": "Dasha di {lord}, sotto-periodo di {subLord}: i loro chakra in primo piano"
    },
